{
  "name": "khmer-alphabet",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop": "concurrently -k -r \"next dev\" \"wait-on -t 30000 http://localhost:3000 && electron .\"",
    "desktop:prod": "npm run build && concurrently -k -r \"next start\" \"wait-on -t 30000 http://localhost:3000 && electron .\"",
    "app": "concurrently -k -r \"npm run server\" \"next dev\" \"wait-on -t 30000 http://localhost:3000 http://localhost:8000/health && electron .\"",
    "server": "bash -c 'source .venv/bin/activate && python -m uvicorn server:app --app-dir tts_server --port 8000'",
    "download:voxcpm2": "bash -c 'source .venv/bin/activate && python3 scripts/download_voxcpm2.py'",
    "generate-audio": "node scripts/generate_audio.js"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "typescript": "^5.6.3",
    "wait-on": "^9.5.1"
  }
}
